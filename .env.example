# ════════════════════════════════════════════════════════════════════
#  GEOMIND — Variables d'environnement
#  Copiez ce fichier en .env.local et remplissez toutes les valeurs.
#  Toutes les variables sont validées par Zod au démarrage (lib/env.ts).
# ════════════════════════════════════════════════════════════════════

# ── Node ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database (Supabase Postgres — connection pooler URI) ─────────────
# Récupérez l'URI dans : Supabase Dashboard → Project Settings → Database → Connection string (Mode: Transaction)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Connexion directe Postgres (non-poolée) — UNIQUEMENT pour drizzle-kit push/migrate
# Dashboard Supabase → Project Settings → Database → Connection string → Mode: Direct
DIRECT_DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────
# Récupérez ces valeurs dans : Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL de base de l'application — utilisée pour les redirections auth (callback, reset-password)
# Dev: http://localhost:3000 | Prod: https://geomind.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ⚠️  Clé service_role — NE JAMAIS exposer côté client.
# Utilisée uniquement par Inngest (background jobs) et scripts admin.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Email transactionnel (Resend) ─────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@geomind.fr

# ── Stripe ────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# https://dashboard.stripe.com/webhooks — endpoint: /api/stripe/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs des prix récurrents (Plan Pro et Business)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# ── LLM ───────────────────────────────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# ── Crawl web (Firecrawl) ─────────────────────────────────────────────
# https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-...

# ── Background jobs (Inngest) ──────────────────────────────────────────
# https://app.inngest.com/env/production/manage/keys
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=signkey-prod-...

# ── Observabilité ─────────────────────────────────────────────────────
# https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=https://[key]@o[org].ingest.sentry.io/[project]
# Même valeur que SENTRY_DSN — exposée côté client (safe)
NEXT_PUBLIC_SENTRY_DSN=https://[key]@o[org].ingest.sentry.io/[project]
# Build-time uniquement (optionnel, pour upload des source maps)
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
# https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
